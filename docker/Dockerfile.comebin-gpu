# Dockerfile.comebin-gpu
# GPU-accelerated COMEBin for prokaryotic binning with PyTorch CUDA.
#
# Build:
#   docker build -f docker/Dockerfile.comebin-gpu \
#       -t ghcr.io/LymF/vapor-comebin-gpu:1.0.4 .
#   docker push ghcr.io/LymF/vapor-comebin-gpu:1.0.4
#
# Enable with --use-gpu in vapor CLI.

FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

LABEL org.opencontainers.image.source="https://github.com/LymF/vapor"
LABEL org.opencontainers.image.description="VAPOR COMEBin GPU image (PyTorch CUDA base)"
LABEL org.opencontainers.image.version="1.0.4"

RUN conda install -n base -c conda-forge -c bioconda --no-deps -y \
        "comebin=1.0.4" \
        "prodigal=2.6.3" \
        "samtools=1.23" \
    && conda clean -afy

CMD ["/bin/bash"]
